@model Storage.Models.ViewModels.ProductIndexViewModel

@{
    ViewData["Title"] = "Products";

    SortOrder GetSortOrder(ProductSortBy sortBy)
    {
        if (Model.SortBy == sortBy)
        {
            return Model.SortOrder == SortOrder.Ascending ? SortOrder.Descending : SortOrder.Ascending;
        }
        else
        {
            return Model.SortOrder;
        }
    }
;

    string GetSortOrderIndicatorStyle()
    {
        string rotation = Model.SortOrder == SortOrder.Ascending
        ? ""
        : "transform: rotate(0.5turn);";

        return rotation + " display: inline-block; width: 1rem; line-height: 1rem; text-align: center; font-size: 0.75rem";
    }
;
}
<form method="get" asp-controller="Products" asp-action="Index">
    <header class="position-fixed bg-body p-3 pb-0 d-flex w-100 align-items-center z-1 overflow-hidden left-0 right-0"
        style="top: 57px;">
        <div class="d-flex w-100 bg-body z-2">
            <h1 class="text-nowrap">Products (@Model.Count)</h1>
            <div class="d-flex gap-2 w-100 align-items-center px-2">
                <p class="m-0 p-2">
                    <a asp-action="Create" class="btn btn-primary text-nowrap">Create New</a>
                </p>
                @if (
                                Model.MinPrice != Model.DefaultMinPrice ||
                                Model.MaxPrice != Model.DefaultMaxPrice ||
                                Model.SelectedCategoryIds?.Count() > 0)
                {
                    <a asp-action="Index" class="btn btn-outline-danger text-nowrap">Clear all filters</a>
                }
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.MinPrice > Model.DefaultMinPrice)
                    {
                        <span class="badge rounded-pill text-bg-secondary">
                            <a asp-route-maxPrice="@Model.MaxPrice" asp-route-minOrderDate="@Model.MinOrderDate"
                                asp-route-maxOrderDate="@Model.MaxOrderDate"
                                asp-route-categories="@Model.SelectedCategoryIds" class="btn-close me-1"></a>
                            @Html.DisplayNameFor(model => model.MinPrice):
                            @Html.DisplayFor(model => model.MinPrice)
                        </span>
                    }
                    @if (Model.MaxPrice < Model.DefaultMaxPrice)
                    {
                        <span class="badge rounded-pill text-bg-secondary">
                            <a asp-route-minPrice="@Model.MinPrice" asp-route-maxOrderDate="@Model.MaxOrderDate"
                                asp-route-categories="@Model.SelectedCategoryIds" class="btn-close me-1"></a>
                            @Html.DisplayNameFor(model => model.MaxPrice):
                            @Html.DisplayFor(model => model.MaxPrice)
                        </span>
                    }
                    @if (Model.MinOrderDate != null)
                    {
                        <span class="badge rounded-pill text-bg-secondary">
                            <a asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                                asp-route-categories="@Model.SelectedCategoryIds"
                                asp-route-maxOrderDate="@Model.MaxOrderDate" class="btn-close me-1"></a>
                            @Html.DisplayNameFor(model => model.MinOrderDate):
                            @Html.DisplayFor(model => model.MinOrderDate)
                        </span>
                    }
                    @if (Model.MaxOrderDate != null)
                    {
                        <span class="badge rounded-pill text-bg-secondary">
                            <a asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                                asp-route-categories="@Model.SelectedCategoryIds"
                                asp-route-minOrderDate="@Model.MinOrderDate" class="btn-close me-1"></a>
                            @Html.DisplayNameFor(model => model.MaxOrderDate):
                            @Html.DisplayFor(model => model.MaxOrderDate)
                        </span>
                    }
                    @foreach (var category in Model.SelectedCategories)
                    {
                        <span class="badge rounded-pill text-bg-secondary">
                            <a asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice"
                                asp-route-minOrderDate="@Model.MinOrderDate" asp-route-maxOrderDate="@Model.MaxOrderDate"
                                class="btn-close me-1"></a>
                            @Html.DisplayNameFor(model => model.SelectedCategories):
                            @Html.DisplayFor(model => model.SelectedCategories)
                        </span>
                    }
                </div>

            </div>
        </div>
    </header>

    <div class="h-100 position-relative d-flex flex-column pe-3" style="width: 100vw;">
        <table class="table mb-0 table-hover position-relative vw-100 overflow-x-scroll"
            style="margin-top: 40px; max-width: 100vw;">
            <thead class="bg-body z-0 w-100 position-sticky border-bottom left-0 right-0 shadow-sm" style="top: 126px;">
                <tr class="w-100 h-100">
                    <th class=" text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-route-sort="@nameof(Model.Product.Name)"
                                asp-route-order="@GetSortOrder(ProductSortBy.Name)" class="text-body">
                                @nameof(Model.Product.Name)
                            </a>
                            @if (Model.SortBy == ProductSortBy.Name)
                            {
                                <div class="" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                            }
                        </div>
                    </th>
                    <th class="text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-route-sort="@nameof(Model.Product.Price)"
                                asp-route-order="@GetSortOrder(ProductSortBy.Price)" class="text-body">
                                @nameof(Model.Product.Price)
                            </a>
                            @if (Model.SortBy == ProductSortBy.Price)
                            {
                                <div class="" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                            }
                            <div class="dropdown">
                                <button
                                    class="btn btn-sm btn-outline-secondary badge rounded-pill text-body text-decoration-none border-secondary-subtle"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    title="@nameof(Model.Product.Price) filter">&#8942;
                                </button>
                                <div class="dropdown-menu">
                                    <div class="d-flex flex-column gap-3 p-2">
                                        <div>
                                            <label for="min-price" class="form-label">Min price:</label>
                                            <output for="min-price" id="min-price-output" aria-hidden="true"></output>
                                            <input id="min-price" name="minPrice" type="range" value="@Model.MinPrice"
                                                min="@Model.DefaultMinPrice" max="@Model.DefaultMaxPrice"
                                                class="form-control">
                                        </div>

                                        <div>
                                            <label for="max-price" class="form-label">Max price:</label>
                                            <output for="max-price" id="max-price-output" aria-hidden="true"></output>
                                            <input id="max-price" name="maxPrice" type="range" value="@Model.MaxPrice"
                                                min="@Model.DefaultMinPrice" max="@Model.DefaultMaxPrice"
                                                class="form-control">
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary btn" type="submit">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </th>
                    <th class="text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-route-sort="@nameof(Model.Product.OrderDate)"
                                asp-route-order="@GetSortOrder(ProductSortBy.OrderDate)" class="text-body">
                                @Html.DisplayNameFor(model => model.Product.OrderDate)
                            </a>
                            @if (Model.SortBy == ProductSortBy.OrderDate)
                            {
                                <div class="" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                            }
                            <div class="dropdown">
                                <button
                                    class="btn btn-sm btn-outline-secondary badge rounded-pill text-body text-decoration-none border-secondary-subtle"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    title="@Html.DisplayNameFor(model => model.Product.OrderDate) filter">&#8942;
                                </button>
                                <div class="dropdown-menu">
                                    <div class="d-flex flex-column gap-3 p-2">
                                        <div class="form-group">
                                            <label for="min-order-date">From:</label>
                                            <input id="min-order-date" name="minOrderDate" asp-for="MinOrderDate"
                                                class="form-control" />
                                        </div>
                                        <div class="form-group">
                                            <label for="max-order-date">To:</label>
                                            <input id="max-order-date" name="maxOrderDate" asp-for="MaxOrderDate"
                                                class="form-control" />
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary btn" type="submit">Apply</button>
                                    </div>
                                </div>
                            </div>
                    </th>
                    <th class="text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-route-sort="@nameof(Model.Product.Category)"
                                asp-route-order="@GetSortOrder(ProductSortBy.Category)" class="text-body">
                                @nameof(Model.Product.Category)
                            </a>
                            @if (Model.SortBy == ProductSortBy.Category)
                            {
                                <div class="" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                            }
                            <div class="dropdown">
                                <button
                                    class="btn btn-sm btn-outline-secondary badge rounded-pill text-body text-decoration-none border-secondary-subtle"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    title="@nameof(Model.Product.Category) filter">&#8942;
                                </button>
                                <div class="dropdown-menu p-0">
                                    <div class="d-flex flex-column gap-3 p-2">
                                        <select size="3" name="categories" asp-for="SelectedCategoryIds"
                                            asp-items="Model.Categories" class="form-select rounded-0"
                                            aria-label="Category select">
                                        </select>
                                        <button class="btn btn-sm btn-outline-primary btn" type="submit">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </th>
                    <th class="text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-route-sort="@nameof(Model.Product.Shelf)"
                                asp-route-order="@GetSortOrder(ProductSortBy.Shelf)" class="text-body">
                                @nameof(Model.Product.Shelf)
                            </a>
                            @if (Model.SortBy == ProductSortBy.Shelf)
                            {
                                <div class="" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                            }
                        </div>
                    </th>
                    <th class="text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-route-sort="@nameof(Model.Product.Count)"
                                asp-route-order="@GetSortOrder(ProductSortBy.Count)" class="text-body">
                                @nameof(Model.Product.Count)
                            </a>
                            @if (Model.SortBy == ProductSortBy.Count)
                            {
                                <div class="" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                            }
                        </div>
                    </th>
                    <th class="text-nowrap">
                        <div class="d-flex gap-2 align-items-center">
                            @nameof(Model.Product.Description)
                        </div>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td class="text-truncate" style="max-width: 200px;">
                            <a asp-action="Details" asp-route-id="@item.Id">@Html.DisplayFor(modelItem => item.Name)</a>
                        </td>
                        <td class="text-nowrap">
                            @Html.DisplayFor(modelItem => item.Price)
                        </td>
                        <td class="text-nowrap">
                            @Html.DisplayFor(modelItem => item.OrderDate)
                        </td>
                        <td class="text-truncate">
                            @Html.DisplayFor(modelItem => item.Category.Name)
                        </td>
                        <td class="text-nowrap">
                            @Html.DisplayFor(modelItem => item.Shelf)
                        </td>
                        <td class="text-nowrap">
                            @Html.DisplayFor(modelItem => item.Count)
                        </td>
                        <td class="text-truncate" style="max-width: 300px;">
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>

<script>
    const formatCurrency = (value) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value);
    const minPriceInput = document.getElementById("min-price");
    const minPriceOutput = document.getElementById("min-price-output");
    minPriceOutput.textContent = formatCurrency(minPriceInput.value);

    minPriceInput.addEventListener('input', function () {
        minPriceOutput.textContent = formatCurrency(this.value);
    });

    const maxPriceInput = document.getElementById("max-price");
    const maxPriceOutput = document.getElementById("max-price-output");
    maxPriceOutput.textContent = formatCurrency(maxPriceInput.value);

    maxPriceInput.addEventListener('input', function () {
        maxPriceOutput.textContent = formatCurrency(this.value);
    });
</script>