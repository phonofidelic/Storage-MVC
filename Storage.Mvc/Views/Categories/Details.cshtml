@model CategoryDetailsViewModel
@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid pt-2">
    <h1>@Model.Name</h1>

    <div class="container-fluid">
        <h4>Category Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-5">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
            <a asp-action="Index">Back to List</a>
        </div>
    </div>

    @if (Model?.Products.Count() > 0)
    {
        <div class="container-fluid">
            <h4>Category Products</h4>
            <hr />
            <table class="table table-hover">
                <thead>
                    <tr>
                        @foreach (var prop in typeof(ProductListItemViewModel)
                                            .GetProperties()
                                            .Where(p => p.Name != "Id")
                                            .Where(p => p.Name != "Category"))
                        {
                            <th class="text-nowrap">
                                @prop.Name
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            @foreach (var prop in item.GetType()
                                                .GetProperties()
                                                .Where(p => p.Name != "Id")
                                                .Where(p => p.Name != "Category"))
                            {
                                if (prop.Name == "Name")
                                {
                                    <td class="text-truncate" style="max-width: 200px;">
                                        <a asp-controller="Products" asp-action="Details"
                                            asp-route-id="@item.Id">@Html.DisplayFor(modelItem
                                                                        => item.Name)</a>
                    </td>
                                        }
                                else
                                {
                                    <td class="text-truncate" style="max-width: 300px;">
                                        @prop.GetValue(item)
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>